; Engine configuration file.
; Godot 4.3+ ile açın. Bu dosyayı elle düzenlerken dikkatli olun.

config_version=5

[application]

config/name="Taşı Bakalım"
config/description="Dar merdivenlerden, kapılardan ve koridorlardan eşyaları çarpmadan taşıdığınız 3D fizik oyunu."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/low_processor_mode=false

[autoload]

Config="*res://scripts/autoload/config.gd"
GameState="*res://scripts/autoload/game_state.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
LevelDB="*res://scripts/autoload/level_db.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Haptics="*res://scripts/autoload/haptics.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
3d/default_gravity=9.8

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="item"
3d_physics/layer_4="obstacle"
3d_physics/layer_5="trigger"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
environment/defaults/default_clear_color=Color(0.53, 0.72, 0.9, 1)

[shader_globals]

cut_height={
"type": "float",
"value": 100000.0
}
